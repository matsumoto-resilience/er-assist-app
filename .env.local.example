# 使用するLLMプロバイダー。 "claude" または "gemini"。未設定時は claude。
LLM_PROVIDER=claude

# Anthropic APIキー。 https://console.anthropic.com/settings/keys から取得してください。
# LLM_PROVIDER=claude のときに必要です。
ANTHROPIC_API_KEY=

# Gemini APIキー。 https://aistudio.google.com/apikey から取得してください。
# LLM_PROVIDER=gemini のときに必要です。
GEMINI_API_KEY=

# --- Clerk 認証(アプリ全体をログイン必須にする) ---
# Vercel Marketplace で Clerk を追加すると下記2つは自動発行される。
#   vercel integration add clerk  →  vercel env pull .env.local
# 手動の場合は https://dashboard.clerk.com の API Keys から取得。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# サインイン/サインアップのパスと、認証後の戻り先。
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
